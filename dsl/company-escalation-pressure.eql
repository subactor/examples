PROFILE eql:pressure-policy/v1
POLICY "company-continuity"
SCORE MIN 0 MAX 100 ROUND nearest

# All business semantics are policy data. The runtime only evaluates generic
# ratios, bounded numeric factors and ordered levels.
RATIO elapsed_sla NUMERATOR elapsed_minutes DENOMINATOR sla_minutes WEIGHT 40 CAP 40
FACTOR financial_impact PATH signals.financial_impact WEIGHT 25 MIN 0 MAX 1
FACTOR person_impact PATH signals.person_impact WEIGHT 20 MIN 0 MAX 1
FACTOR service_impact PATH signals.service_impact WEIGHT 30 MIN 0 MAX 1

LEVEL low MIN 0 STRATEGY "monitor"
LEVEL medium MIN 30 STRATEGY "email_reminder"
LEVEL high MIN 55 STRATEGY "email_and_deputy"
LEVEL critical MIN 80 STRATEGY "quorum_and_external_provider"

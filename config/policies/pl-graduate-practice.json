{
  "schema":"subactor.rule-policy/v1",
  "id":"pl-graduate-practice-eligibility",
  "jurisdiction":"PL",
  "legal_basis":["PL-PRAKTYKI-ABSOLWENCKIE"],
  "required_facts":["age_at_start","minimum_education_complete","duration_months","written_agreement","insurance_confirmed","bhp_ready"],

    {"field":"duration_months","operator":"lte","value":3,"reason":"duration_limit_exceeded"},
    {"field":"written_agreement","operator":"eq","value":true,"reason":"written_agreement_missing"},
    {"field":"insurance_confirmed","operator":"eq","value":true,"reason":"insurance_not_confirmed"},
    {"field":"bhp_ready","operator":"eq","value":true,"reason":"bhp_not_ready"}

{
  "schema":"subactor.escalation-policy/v1",
  "id":"company-continuity",
  "sample_elapsed_minutes":65,
  "sla_minutes":60,
  "signal_labels":{
    "service_impact":["service-impact","infrastructure"],
    "person_impact":["person-impact"],
    "financial_impact":["financial-impact","revenue"]
  },
  "default_route":{"owner":"human:founder","channels":["planfile","email"],"substitute_after_sla":"human:deputy-founder","sla_minutes":60},
  "routes":[
    {"labels_any":["infrastructure","service-impact"],"owner":"human:operations-lead","channels":["planfile","email"],"substitute_after_sla":"human:continuity-officer","sla_minutes":30},
    {"labels_any":["person-impact","legal"],"owner":"human:hr-authority","channels":["planfile","email"],"substitute_after_sla":"continuity-council","sla_minutes":60}
  ]
}
